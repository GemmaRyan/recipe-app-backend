{ "name" : "Banana Bread",
  "ingredients" : [ "225g self-raising flour", 
                     "55g caster sugar", 
                     "1 tsp baking powder", 
                     "½ tsp salt", 
                     "55g cold butter, diced", 
                     "150ml whole milk",
                     "2 ripe bananas, mashed",
                     "1 tsp vanilla extract"
                  ],
  "recipe" : [ "Heat oven to 180C/160C fan/gas 4. Grease and line a 2lb loaf tin with baking parchment.",
               "Add all ingretients but the bananas and vanilla extract together and mix well", 
               "Add the vanilla extract and mashed bananas. Mix well",
               "Pour into a greased loaf tin and bake for 40-50 mins until a skewer inserted into the middle comes out clean",
               "Cool in the tin for 10 mins, then turn out onto a wire rack to cool completely."
               ],
   "cookingDuration": "70-80 ",
   "difficulty": 1,
   "origin": "https://www.bbcgoodfood.com/recipes/raspberry-white-chocolate-scones",
   "imageUrl": "https://images.immediate.co.uk/production/volatile/sites/30/2021/05/Raspberry_White-Chocolate-Scones-f6060f2.jpg?quality=90&webp=true&resize=900,817"
}


