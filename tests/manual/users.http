{
   "name": "AppleTart",
   "ingredients": [
       "1 sheet puff pastry",
       "3 apples, peeled, cored and sliced",
       "50g sugar",
       "1 tsp cinnamon",
       "1 tbsp butter, melted"
   ],
   "recipe": [
       "Preheat the oven to 200C/180C fan/gas 6.",
       "Roll out the puff pastry on a floured surface and place it in a tart tin.",
       "Arrange the apple slices on top of the pastry.",
       "Mix the sugar and cinnamon together, then sprinkle over the apples.",
       "Drizzle the melted butter over the top.",
       "Bake for 25-30 minutes until the pastry is golden and the apples are tender."
   ],
   "cookingDuration": "25-30 ",
   "difficulty": 2,
   "origin": "https://www.bbcgoodfood.com/recipes/apple-tart",
   "imageUrl": "https://www.apple-pinklady.com/app/uploads/2025/02/PL-Recette-600x1065-Tarte-pomme-irlandaise.jpg"

}


